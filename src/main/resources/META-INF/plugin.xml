<idea-plugin require-restart="false">
    <id>com.ddoong2.endpointfinder</id>
    <name>Endpoint Finder</name>
    <vendor email="kkode1911@gmail.com" url="https://github.com/daejoon">daejoon</vendor>

    <!-- Product and plugin compatibility requirements -->
    <!-- https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends optional="true" config-file="pluginKotlin.xml">org.jetbrains.kotlin</depends>

    <actions>
        <action id="GoToRequestMapping" class="com.ddoong2.endpointfinder.GoToRequestMappingAction"
          text="Request Mapping" description="Request mapping">
            <add-to-group group-id="GoToTargetEx" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl BACK_SLASH"/>
        </action>
    </actions>

    <extensionPoints>
        <extensionPoint name="requestMappingContributor" interface="com.intellij.navigation.ChooseByNameContributor"/>
    </extensionPoints>

    <extensions  defaultExtensionNs="com.intellij">
        <searchEverywhereContributor implementation="com.ddoong2.endpointfinder.RequestMappingGoToContributor$Factory"/>
    </extensions>

    <extensions defaultExtensionNs="com.ddoong2.endpointfinder">
        <requestMappingContributor implementation="com.ddoong2.endpointfinder.contributor.JavaRequestMappingContributor"/>
    </extensions>
</idea-plugin>
